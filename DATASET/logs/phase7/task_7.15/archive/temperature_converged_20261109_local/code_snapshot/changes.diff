+        NLL is convex in beta=1/T. Its monotone derivative brackets an interior
+        minimum, or identifies a constrained endpoint minimum. ``lr`` remains
+        accepted for old callers; this root solver has no learning rate.
+        The second return value equals T: no unconstrained fit is clipped later.
+        """
+        self.fit_diagnostics = None
+        values = logits.detach().to(device="cpu", dtype=torch.float64).numpy()
+        labels = targets.detach().cpu().numpy()
+        if (values.ndim != 2 or values.shape[1] != 2 or not len(values)
+                or labels.shape != (len(values),) or labels.dtype.kind not in "iu"
+                or not np.isin(labels, [0, 1]).all() or not np.isfinite(values).all()):
+            raise ValueError("Temperature fit requires finite [N,2] logits and integer 0/1 targets")
+        if not isinstance(max_iter, int) or max_iter < 1:
+            raise ValueError("max_iter must be a positive integer")
+        delta = values[:, 1] - values[:, 0]
+        scale = max(1., float(np.mean(np.abs(delta))))
+
+        def gradient(beta):
+            probability = np.exp(-np.logaddexp(0., -beta * delta))
+            return float(np.mean(delta * (probability - labels)))
+
+        def nll(temperature):
+            margin = delta / temperature
+            return float(np.mean(np.logaddexp(0., margin) - labels * margin))
+
+        lower, upper = .1, 20.  # beta bounds, corresponding to T=10 and T=.05
+        iterations = 0
+        if not np.any(delta):
+            temperature, status = 1., "flat_objective"
+        elif gradient(lower) >= 0:
+            temperature, status = 10., "upper_temperature_bound"
+        elif gradient(upper) <= 0:
+            temperature, status = .05, "lower_temperature_bound"
+        else:
+            for iterations in range(1, max_iter + 1):
+                beta = (lower + upper) / 2.
+                slope = gradient(beta)
+                if abs(slope) <= 1e-10 * scale or upper - lower <= 1e-12 * max(1., abs(beta)):
