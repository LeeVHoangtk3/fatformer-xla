import os
import glob
import shutil
import subprocess

clip_dir = "/kaggle/working/fatformer-xla/src/models/clip"
os.makedirs(clip_dir, exist_ok=True)
target_gz = os.path.join(clip_dir, "bpe_simple_vocab_16e6.txt.gz")
txt_path = os.path.join(clip_dir, "bpe_simple_vocab_16e6.txt")

# 1. Nếu file .txt đang có sẵn trong thư mục, nén lại thành .gz theo chuẩn CLIP
if os.path.exists(txt_path) and not os.path.exists(target_gz):
    print(f"[*] Phát hiện file BPE dạng .txt. Đang nén lại thành: {target_gz}...")
    subprocess.run(f"gzip -c '{txt_path}' > '{target_gz}'", shell=True, check=True)
    print(f"[✓] Tái tạo thành công file: {target_gz} ({os.path.getsize(target_gz):,} bytes)!")

# 2. Nếu chưa có, quét tìm trên toàn bộ Kaggle input để nạp vào
elif not os.path.exists(target_gz):
    candidates = glob.glob("/kaggle/**/bpe_simple_vocab_16e6.txt*", recursive=True)
    for c in candidates:
        if c.endswith(".gz"):
            shutil.copy2(c, target_gz)
            print(f"[✓] Đã copy file .gz từ: {c}")
            break
        elif c.endswith(".txt"):
            subprocess.run(f"gzip -c '{c}' > '{target_gz}'", shell=True, check=True)
            print(f"[✓] Đã nén và tái tạo file từ: {c}")
            break

print(f"\n[✓] SẴN SÀNG! Kích thước file BPE: {os.path.getsize(target_gz):,} bytes")



