import os
import re
import subprocess

base_dir = "/kaggle/working/fatformer-xla"

def patch_typing(rel_path):
    fpath = os.path.join(base_dir, rel_path)
    if not os.path.exists(fpath):
        return
    with open(fpath, "r", encoding="utf-8") as f:
        content = f.read()
    
    typing_line = "from typing import Optional, Dict, Any, List, Tuple, Union, Set\n"
    if "from typing import Optional, Dict, Any" not in content:
        if "from typing import" in content:
            content = re.sub(r"from typing import [^\n]+", typing_line.strip(), content)
        else:
            content = typing_line + content
        with open(fpath, "w", encoding="utf-8") as f:
            f.write(content)
        print(f"[✓] Đã bổ sung typing an toàn cho: {rel_path}")

# 1. Vá lỗi typing cho transforms và metrics
patch_typing("src/datasets/transforms.py")
patch_typing("src/evaluation/metrics.py")

# 2. Đảm bảo file từ vựng BPE nén sẵn sàng
clip_dir = os.path.join(base_dir, "src/models/clip")
txt_bpe = os.path.join(clip_dir, "bpe_simple_vocab_16e6.txt")
gz_bpe = os.path.join(clip_dir, "bpe_simple_vocab_16e6.txt.gz")
if os.path.exists(txt_bpe) and not os.path.exists(gz_bpe):
    subprocess.run(f"gzip -c '{txt_bpe}' > '{gz_bpe}'", shell=True, check=True)
    print(f"[✓] Đã nén và tạo file BPE: {gz_bpe}")

print("\n🚀 ĐÃ VÁ LỖI XONG TOÀN DIỆN! Bây giờ bạn hãy bấm chạy Cell 3.")



